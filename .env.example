HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
OLLAMA_URL=http://127.0.0.1:11434
# Server mode: Postgres + Redis (docker compose up -d redis postgres).
# Remove both lines (or leave them empty) for single-user mode: SQLite in DATA_DIR,
# in-memory rate limiting, no Docker. `npm run dev:single` does that without editing.
REDIS_URL=redis://127.0.0.1:6379
DATABASE_URL=postgres://llmgw:llmgw@127.0.0.1:5432/llmgw
# DATA_DIR=  (single-user data folder; default ~/Library/Application Support/llm-gateway on macOS)
ALLOWED_MODELS=llama3.2:3b,backend-mentor
DEFAULT_MODEL=llama3.2:3b
MAX_CONCURRENCY=1
MAX_QUEUE=2
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW=1 minute
REQUEST_TIMEOUT_MS=120000
MODEL_CONTEXT_TOKENS=4096
RESERVE_OUTPUT_TOKENS=800
MAX_HISTORY_MESSAGES=100
LEASE_SECONDS=180